# Ambiente
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Dados: as fontes do INEP somam ~82 MB e são públicas e reprodutíveis.
# data/raw/README.md tem a URL de cada arquivo.
data/raw/*
!data/raw/README.md

# Saída do pipeline — gerada por `python gerar_gold.py`
data/gold/*
!data/gold/.gitkeep
reports/manifest.json
reports/RELATORIO_VALIDACAO.md

# Saída da modelagem — gerada por `python prever_municipios.py`.
# O ranking em markdown vai versionado em reports/; o Parquet completo, não.
data/predictions/*
!data/predictions/.gitkeep

# Modelos treinados e artefatos pesados
*.pkl
*.joblib

# OS / IDE
.DS_Store
.vscode/
.idea/

# Testes
.pytest_cache/
